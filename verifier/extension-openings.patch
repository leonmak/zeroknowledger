+          // Hand each hash commitment's opening back to the caller, so it can
+          // prove statements about the committed plaintext (e.g. in a ZK
+          // circuit) without revealing it. Plaintext stays on this device:
+          // it's returned to the plugin, never sent to the verifier.
+          const toHex = (bytes: ArrayLike<number>) =>
+            Array.from(bytes, (b) => b.toString(16).padStart(2, '0')).join('');
+          const commitments = commit
+            ? (() => {
+                const sentBytes = proveManager.getSentBytes(proverId);
+                const recvBytes = proveManager.getRecvBytes(proverId);
+                const open = (
+                  ranges: { start: number; end: number; algorithm: string }[],
+                  opened: { hash: ArrayLike<number>; blinder: ArrayLike<number> }[],
+                  bytes: Uint8Array,
+                ) =>
+                  ranges.map((r, i) => ({
+                    start: r.start,
+                    end: r.end,
+                    algorithm: r.algorithm,
+                    hash: toHex(opened[i]?.hash ?? []),
+                    blinder: toHex(opened[i]?.blinder ?? []),
+                    plaintext: toHex(bytes.subarray(r.start, r.end)),
+                  }));
+                return {
+                  sent: open(commit.sent, openings.sent, sentBytes),
+                  recv: open(commit.recv, openings.recv, recvBytes),
+                };
+              })()
+            : undefined;
+
