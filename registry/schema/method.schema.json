{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zeroknowledger.com/schemas/method.schema.json",
  "title": "zeroknowledger method version",
  "description": "One published version of a method. Immutable once merged: fixes ship as a new version. Health and soundness live in the method's status.json, not here.",
  "type": "object",
  "required": [
    "id",
    "version",
    "proof_type",
    "runtime",
    "claim",
    "disclose",
    "badge",
    "freshness",
    "maintainers",
    "config"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "description": "namespace/name. Also the directory: methods/<id>/<version>.json",
      "type": "string",
      "pattern": "^[a-z0-9-]+/[a-z0-9-]+$"
    },
    "version": {
      "description": "Semver. patch: extraction fixes, same claim and disclosure. minor: adds optional disclosures. major: claim meaning changes (the only kind of release that may change proof_type or nullifier.scope).",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "proof_type": {
      "description": "Must be an id in proof-types.json. The proof type owns the circuit/protocol and the verifier; a method only configures it.",
      "type": "string"
    },
    "runtime": {
      "description": "Where the user generates the proof.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "web-wasm",
          "cli",
          "extension-tlsn",
          "mobile"
        ]
      }
    },
    "claim": {
      "type": "string",
      "minLength": 10
    },
    "risk": {
      "description": "How sensitive the underlying account/data is.",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "disclose": {
      "type": "object",
      "required": [
        "mode",
        "output"
      ],
      "properties": {
        "mode": {
          "enum": [
            "boolean",
            "presence",
            "threshold",
            "exact",
            "range"
          ]
        },
        "comparison": {
          "enum": [
            "gte",
            "lte",
            "eq"
          ]
        },
        "value": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "object",
              "required": [
                "min",
                "max"
              ],
              "properties": {
                "min": {
                  "type": "number"
                },
                "max": {
                  "type": "number"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "output": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        }
      },
      "additionalProperties": false
    },
    "nullifier": {
      "description": "One badge per underlying account. The scope must stay the same across minor/patch versions, or the same account could claim again.",
      "type": "object",
      "required": [
        "scope",
        "derived_from"
      ],
      "properties": {
        "scope": {
          "type": "string"
        },
        "derived_from": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "privacy": {
      "description": "How the method keeps the holder's data private, stated plainly: what it guarantees, what it doesn't (yet), and who has to be trusted.",
      "type": "object",
      "required": [
        "guarantees",
        "limits"
      ],
      "properties": {
        "summary": {
          "type": "string"
        },
        "guarantees": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "limits": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "trust": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "badge": {
      "type": "object",
      "required": [
        "label",
        "icon",
        "color"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "icon": {
          "type": "string"
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        }
      },
      "additionalProperties": false
    },
    "freshness": {
      "description": "Defaults for accepting parties: a badge older than this may no longer be true.",
      "type": "object",
      "required": [
        "max_age_days",
        "stale_after_days"
      ],
      "properties": {
        "max_age_days": {
          "type": "integer",
          "minimum": 1
        },
        "stale_after_days": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "maintainers": {
      "description": "GitHub handles responsible for this method.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "source": {
      "description": "Where the prover/circuit code for this method lives.",
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "changelog": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "config": {
      "description": "Proof-type-specific settings, checked against $defs/<proof_type>.",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "proof_type": {
            "const": "tlsn"
          }
        }
      },
      "then": {
        "properties": {
          "config": {
            "$ref": "#/$defs/tlsn"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "proof_type": {
            "const": "dkim-email"
          }
        }
      },
      "then": {
        "properties": {
          "config": {
            "$ref": "#/$defs/dkim-email"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "proof_type": {
            "const": "opencerts"
          }
        }
      },
      "then": {
        "properties": {
          "config": {
            "$ref": "#/$defs/opencerts"
          }
        }
      }
    }
  ],
  "$defs": {
    "tlsn": {
      "type": "object",
      "required": [
        "target",
        "prove_params"
      ],
      "properties": {
        "target": {
          "type": "object",
          "required": [
            "api_url",
            "method",
            "host",
            "window_url",
            "auth",
            "tls_min"
          ],
          "properties": {
            "api_url": {
              "type": "string",
              "pattern": "^https://"
            },
            "method": {
              "enum": [
                "GET",
                "POST"
              ]
            },
            "host": {
              "type": "string"
            },
            "window_url": {
              "type": "string",
              "pattern": "^https://"
            },
            "auth": {
              "type": "object",
              "required": [
                "strategy",
                "intercept_filter",
                "required_headers"
              ],
              "properties": {
                "strategy": {
                  "enum": [
                    "cookie",
                    "cookie+csrf",
                    "bearer"
                  ]
                },
                "intercept_filter": {
                  "type": "string"
                },
                "required_headers": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "required_cookie": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "tls_min": {
              "enum": [
                "1.2",
                "1.3"
              ]
            }
          },
          "additionalProperties": false
        },
        "prove_params": {
          "type": "object",
          "required": [
            "max_recv_data",
            "max_sent_data",
            "reveal_fields"
          ],
          "properties": {
            "max_recv_data": {
              "type": "integer",
              "minimum": 1
            },
            "max_sent_data": {
              "type": "integer",
              "minimum": 1
            },
            "reveal_fields": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "reveal_regex": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "regex"
                ],
                "properties": {
                  "regex": {
                    "type": "string"
                  },
                  "flags": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            },
            "notes": {
              "type": "string"
            },
            "commit_fields": {
              "description": "JSON paths hash-committed instead of revealed: the verifier gets SHA256(key-value bytes || 16-byte blinder), the plaintext stays on the device.",
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "dkim-email": {
      "type": "object",
      "required": [
        "circuit",
        "header",
        "key",
        "rules"
      ],
      "properties": {
        "circuit": {
          "description": "Pins the exact compiled circuit and verification key this version accepts.",
          "type": "object",
          "required": [
            "name",
            "noir_version",
            "artifact_sha256",
            "vk_sha256"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "noir_version": {
              "type": "string"
            },
            "artifact_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "vk_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        },
        "header": {
          "type": "object",
          "required": [
            "field",
            "max_signed_bytes"
          ],
          "properties": {
            "field": {
              "enum": [
                "to"
              ]
            },
            "max_signed_bytes": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "key": {
          "type": "object",
          "required": [
            "algorithm",
            "bits",
            "lookup"
          ],
          "properties": {
            "algorithm": {
              "enum": [
                "rsa-sha256"
              ]
            },
            "bits": {
              "enum": [
                2048
              ]
            },
            "lookup": {
              "description": "Whose DNS the key must come from.",
              "enum": [
                "recipient-domain"
              ]
            }
          },
          "additionalProperties": false
        },
        "rules": {
          "description": "What the circuit enforces, in plain words.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "opencerts": {
      "type": "object",
      "required": ["issuer", "reveal"],
      "properties": {
        "issuer": {
          "description": "Pins who counts as the issuer: only batches issued in this certificate store contract are accepted.",
          "type": "object",
          "required": ["name", "network", "certificate_store"],
          "properties": {
            "name": { "type": "string" },
            "network": { "enum": ["ethereum-mainnet"] },
            "certificate_store": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" }
          },
          "additionalProperties": false
        },
        "schemas": {
          "description": "Accepted values of the document's top-level schema/version field.",
          "type": "array",
          "items": { "type": "string" }
        },
        "reveal": {
          "description": "Flattened data paths (as OpenAttestation hashes them, e.g. issuers.0.certificateStore). Everything else must stay obfuscated.",
          "type": "object",
          "required": ["required"],
          "properties": {
            "required": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
            "optional": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
