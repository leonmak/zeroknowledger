{
  "$schema": "../../../schema/method.schema.json",
  "id": "credential/aws-certified-badge",
  "version": "0.1.0",
  "proof_type": "tlsn",
  "runtime": [
    "extension-tlsn"
  ],
  "claim": "AWS Certification account lists at least one active certification.",
  "risk": "medium",
  "disclose": {
    "mode": "boolean",
    "output": "aws_certification_present"
  },
  "badge": {
    "label": "AWS Certified",
    "icon": "shield",
    "color": "#F97316"
  },
  "freshness": {
    "max_age_days": 180,
    "stale_after_days": 365
  },
  "maintainers": [
    "leonmak"
  ],
  "changelog": "Migrated from docs/tlsnotary/templates (seed library draft).",
  "tags": [
    "credential",
    "cloud",
    "career"
  ],
  "config": {
    "target": {
      "api_url": "https://api.credly.com/v1/me/earned_badges?filter=state::accepted&page_size=1",
      "method": "GET",
      "host": "api.credly.com",
      "window_url": "https://www.credly.com/users/me",
      "auth": {
        "strategy": "bearer",
        "intercept_filter": "https://api.credly.com/*",
        "required_headers": [
          "Authorization"
        ]
      },
      "tls_min": "1.2"
    },
    "prove_params": {
      "max_recv_data": 5000,
      "max_sent_data": 1000,
      "reveal_fields": [
        "data.0.badge_template.name",
        "data.0.badge_template.issuer.name"
      ],
      "notes": "AWS certifications are issued via Credly. Bearer token intercepted from api.credly.com requests. Filter state::accepted excludes pending or revoked badges."
    }
  }
}
