    {
      "id": "education/nus-graduate",
      "latest": "0.1.0",
      "versions": [
        {
          "version": "0.1.0",
          "sha256": "a4561a46d8f9a800bd78d6da5c48cd6f5cf0a1d5b4d8bb9189d40a10150995db",
          "health": "working",
          "health_note": "End to end with a real 2019 NUS certificate (opencerts/v1.5): browser disclosure, verifier check, Ethereum issuance and revocation lookups, badge issued, second holder rejected. The certificate store address is taken from that certificate and its on-chain record; not yet cross-checked against the official OpenCerts issuer registry.",
          "soundness": "unreviewed",
          "last_checked": "2026-10-01"
        }
      ],
      "manifest": {
        "$schema": "../../../schema/method.schema.json",
        "id": "education/nus-graduate",
        "version": "0.1.0",
        "proof_type": "opencerts",
        "runtime": [
          "web-wasm"
        ],
        "claim": "Holds a degree conferred by the National University of Singapore, shown by an NUS-issued OpenCerts certificate whose batch is recorded in NUS's certificate store and not revoked.",
        "risk": "medium",
        "disclose": {
          "mode": "presence",
          "output": "nus_degree_conferred"
        },
        "nullifier": {
          "scope": "opencerts:education/nus-graduate:v1",
          "derived_from": "HMAC(server key, scope ‖ certificate targetHash): one badge holder per certificate"
        },
        "privacy": {
          "summary": "Your browser hides every field except the degree title and NUS's details before anything is sent.",
          "guarantees": [
            "Your name, student ID, date of birth and grades never leave your browser; the server only gets their salted hashes, which can't be reversed or guessed.",
            "The server stores only the badge and a keyed hash of the certificate, not the degree title."
          ],
          "limits": [
            "Not zero-knowledge yet: the server sees the certificate's hash and its batch's Merkle root, which are stable identifiers. Anyone you've shown the full certificate to could link the two.",
            "The degree title is revealed to the server when proving (it's how the server knows a degree was conferred)."
          ],
          "trust": [
            "The zeroknowledger server, to discard the degree title and not log certificate hashes.",
            "An Ethereum RPC provider sees the certificate and batch hashes when the server checks issuance and revocation."
          ]
        },
        "badge": {
          "label": "NUS graduate",
          "icon": "graduation",
          "color": "#EF7C00"
        },
        "freshness": {
          "max_age_days": 3650,
          "stale_after_days": 7300
        },
        "maintainers": [
          "leonmak"
        ],
        "source": {
          "name": "zeroknowledger",
          "path": "verifier/src/opencerts.ts"
        },
        "changelog": "First release: selective disclosure, checked against NUS's certificate store on Ethereum.",
        "tags": [
          "education",
          "university",
          "singapore"
        ],
        "config": {
          "issuer": {
            "name": "National University of Singapore",
            "network": "ethereum-mainnet",
            "certificate_store": "0xA204F16717fbF580d6A0535b58063fB4fce969fF"
          },
          "schemas": [
            "opencerts/v1.5",
            "opencerts/v2.0"
          ],
          "reveal": {
            "required": [
              "issuers.0.certificateStore",
              "additionalData.degreeScroll.0.degreeTitle"
            ],
            "optional": [
              "issuers.0.name",
              "additionalData.degreeScroll.0.dateConferred"
            ]
          }
        }
      }
    },
    {
      "id": "employment/work-email",
      "latest": "0.1.0",
      "versions": [
        {
          "version": "0.1.0",
          "sha256": "f1292be71a37b9d9c7668e642f04686603af91010c1d0c683447b69fe38fd416",
          "health": "working",
          "last_checked": "2026-10-01",
          "health_note": "Works end to end (web page and CLI on Cloudflare Workers) for organisations that DKIM-sign their own internal mail, such as Google Workspace. Does not work for Microsoft 365 organisations: internal mail is delivered unsigned (confirmed with NUS). Many signers also leave cc out of h=, which this method requires.",
          "soundness": "unreviewed"
        }
      ],
      "manifest": {
        "$schema": "../../../schema/method.schema.json",
        "id": "employment/work-email",
        "version": "0.1.0",
        "proof_type": "dkim-email",
        "runtime": [
          "web-wasm",
          "cli"
        ],
        "claim": "Received a DKIM-signed email addressed only to an address at this domain, signed with the domain's own key. Proves you had (or have) an address there, without revealing which.",
        "risk": "medium",
        "disclose": {
          "mode": "exact",
          "output": "recipient_domain"
        },
        "nullifier": {
          "scope": "zkbadge-v1",
          "derived_from": "pedersen(scope, length, lowercased recipient address): one claim per address"
        },
        "badge": {
          "label": "Verified employee",
          "icon": "briefcase",
          "color": "#2F5D50"
        },
        "freshness": {
          "max_age_days": 365,
          "stale_after_days": 730
        },
        "maintainers": [
          "leonmak"
        ],
        "source": {
          "name": "zkbadge",
          "path": "circuits/zkbadge/src/main.nr"
        },
        "changelog": "First release (badge.zeroknowledger.com and the zkbadge CLI).",
        "tags": [
          "employment",
          "email",
          "career"
        ],
        "config": {
          "circuit": {
            "name": "zkbadge",
            "noir_version": "1.0.0-beta.5",
            "artifact_sha256": "e861d37f16646a4a7f0e5e8d790408f5dee7b613738353be74b241038c916d4a",
            "vk_sha256": "5c9021656a11aea01b4e0b2a64bbd26152fa65164d15ad86e5373e82334d3a8e"
          },
          "header": {
            "field": "to",
            "max_signed_bytes": 1024
          },
          "key": {
            "algorithm": "rsa-sha256",
            "bits": 2048,
            "lookup": "recipient-domain"
          },
          "rules": [
            "The DKIM signature verifies over the signed headers.",
            "Exactly one To header, holding exactly one address.",
            "No Cc header, and the signature's h= tag lists cc (so the absence of Cc is signed).",
            "The key is published under the recipient's own domain.",
            "The proof is bound to a one-time code, so it can't be replayed on another link.",
            "Bcc recipients can't be detected: use emails sent only to you."
          ]
        }
      }
    },
