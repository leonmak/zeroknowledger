{
  "name": "fitness/strava-active-athlete",
  "version": "0.1.0",
  "status": "draft",
  "claim": "Strava profile shows at least one activity in the last 30 days.",
  "owner": {
    "team": "seed-library",
    "reviewed_by": "pending"
  },
  "risk": "low",
  "target": {
    "api_url": "https://www.strava.com/api/v3/athlete/activities?per_page=1",
    "method": "GET",
    "host": "www.strava.com",
    "window_url": "https://www.strava.com/dashboard",
    "auth": {
      "strategy": "bearer",
      "intercept_filter": "https://www.strava.com/api/v3/*",
      "required_headers": ["Authorization"]
    },
    "tls_min": "1.2"
  },
  "prove_params": {
    "max_recv_data": 3000,
    "max_sent_data": 1000,
    "reveal_fields": ["0.start_date_local", "0.type"],
    "notes": "Bearer token intercepted from Strava browser session. Returns most recent activity. Verifier checks start_date_local is within 30 days. Activity type revealed but not checked."
  },
  "disclose": {
    "mode": "threshold",
    "comparison": "gte",
    "value": 10,
    "output": "strava_activities_30d_gte_10"
  },
  "badge": {
    "label": "Active Athlete",
    "icon": "activity",
    "color": "#EA580C"
  },
  "freshness": {
    "max_age_days": 14,
    "stale_after_days": 30
  },
  "tags": ["fitness", "activity", "lifestyle"]
}
