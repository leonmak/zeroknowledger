{
  "name": "freelance/upwork-top-rated",
  "version": "0.1.0",
  "status": "draft",
  "claim": "Upwork account has Top Rated or Top Rated Plus status.",
  "owner": {
    "team": "seed-library",
    "reviewed_by": "pending"
  },
  "risk": "medium",
  "target": {
    "api_url": "https://www.upwork.com/ab/talent-api/v2/contractor/me/badges",
    "method": "GET",
    "host": "www.upwork.com",
    "window_url": "https://www.upwork.com/",
    "auth": {
      "strategy": "cookie",
      "intercept_filter": "https://www.upwork.com/ab/talent-api/*",
      "required_headers": ["Cookie"]
    },
    "tls_min": "1.2"
  },
  "prove_params": {
    "max_recv_data": 3000,
    "max_sent_data": 4096,
    "reveal_fields": ["badge.tier"],
    "notes": "Upwork talent API returns badge object with tier field. Expected values: TOP_RATED, TOP_RATED_PLUS, or absent. Cookie auth from upwork.com browser session."
  },
  "disclose": {
    "mode": "boolean",
    "output": "upwork_top_rated_status"
  },
  "badge": {
    "label": "Top Rated Freelancer",
    "icon": "star",
    "color": "#84CC16"
  },
  "freshness": {
    "max_age_days": 30,
    "stale_after_days": 45
  },
  "tags": ["freelance", "work", "reputation"]
}
