{
  "name": "identity/singpass-verified-user",
  "version": "0.1.0",
  "status": "draft",
  "claim": "Holds a Singpass account with a 2FA-verified login session.",
  "owner": {
    "team": "seed-library",
    "reviewed_by": "pending"
  },
  "risk": "high",
  "target": {
    "api_url": "https://portal.singpass.gov.sg/home/api/secured/get-session-dtl",
    "method": "GET",
    "host": "portal.singpass.gov.sg",
    "window_url": "https://portal.singpass.gov.sg/home/ui/welcome",
    "auth": {
      "strategy": "cookie",
      "intercept_filter": "https://portal.singpass.gov.sg/home/api/*",
      "required_headers": [
        "Cookie"
      ],
      "required_cookie": "SP-PORTAL-SESSION-ID"
    },
    "tls_min": "1.2"
  },
  "prove_params": {
    "max_recv_data": 2048,
    "max_sent_data": 4096,
    "reveal_fields": [
      "status",
      "result.twofa_verified"
    ],
    "notes": "Session detail endpoint called by the Singpass portal after login. Response: { status, result: { full_name, twofa_verified, redirect_id, kiosk_admin } }. full_name is deliberately NOT revealed. Verifier checks status == SUCCESS and result.twofa_verified == true."
  },
  "disclose": {
    "mode": "boolean",
    "output": "singpass_2fa_verified"
  },
  "issue_when": {
    "status": 200,
    "max_age_seconds": 600,
    "json": {
      "status": "SUCCESS",
      "result.twofa_verified": true
    }
  },
  "badge": {
    "label": "Singpass Verified",
    "icon": "shield",
    "color": "#C8102E"
  },
  "freshness": {
    "max_age_days": 30,
    "stale_after_days": 90
  },
  "tags": [
    "identity",
    "government",
    "singapore"
  ]
}
